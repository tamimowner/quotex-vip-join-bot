# Telegram
BOT_TOKEN=your_bot_token_here
ADMIN_IDS=123456789,987654321

# VIP Group (bot must be admin with invite users permission)
VIP_GROUP_ID=-100xxxxxxxxxx

# Affiliate / Partner settings
AFFILIATE_LINK_BASE=https://qxbroker.com/sign-up/your-partner-code?lid=1476468&click_id={click_id}&site_id={site_id}
SITE_ID=your_site_id

# Database (Railway PostgreSQL)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/railway

# Postback server
POSTBACK_SECRET=optional_secret_for_extra_security
HOST=0.0.0.0
PORT=8000

# Language default
DEFAULT_LANGUAGE=bn
