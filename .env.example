# Telegram
BOT_TOKEN=your_bot_token_here
ADMIN_IDS=123456789

# VIP Group (bot must be admin if you use join tracking)
VIP_GROUP_ID=-100xxxxxxxxxx

# Static VIP invite link — same link for every verified user (PHP style)
VIP_GROUP_LINK=https://t.me/+YourInviteHash

# Affiliate / Partner — YOUR main link
AFFILIATE_LINK_BASE=https://broker-qx.pro/sign-up/?lid=1480996&click_id={click_id}&site_id={site_id}
SITE_ID=1

# Database (Railway PostgreSQL)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/railway

# Postback server
HOST=0.0.0.0
PORT=8000

DEFAULT_LANGUAGE=bn

# Web Admin Panel (Telegram /admin → Web Panel)
# Your Railway public URL, no trailing slash
WEB_BASE_URL=https://your-app.up.railway.app
# Secret token for /admin page (also used as ?token=)
ADMIN_WEB_TOKEN=change_this_to_a_long_secret
# Optional: real AI captions
# OPENAI_API_KEY=
