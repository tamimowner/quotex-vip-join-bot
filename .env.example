# Telegram
BOT_TOKEN=your_bot_token_here
ADMIN_IDS=123456789

# VIP Group (bot must be admin if you use join tracking)
VIP_GROUP_ID=-100xxxxxxxxxx

# Static VIP invite link — same link for every verified user
VIP_GROUP_LINK=https://t.me/+YourInviteHash

# Affiliate / Partner — YOUR main link
AFFILIATE_LINK_BASE=https://broker-qx.pro/sign-up/?lid=1209415
SITE_ID=1

# Database (Railway PostgreSQL)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/railway

# Postback server
HOST=0.0.0.0
PORT=8000

DEFAULT_LANGUAGE=bn

# Public URL (for bot /admin link)
WEB_BASE_URL=https://your-app.up.railway.app

# Website Admin Panel login (browser: /admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_strong_password
